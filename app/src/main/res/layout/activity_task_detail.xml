<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <!-- ปุ่มกลับ -->

    <!-- ข้อความ เพิ่มงาน -->

    <ImageView
        android:id="@+id/debtnBack"
        android:layout_width="27dp"
        android:layout_height="30dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.092"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- กรอบแรก -->
    <TextView
        android:id="@+id/detitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="รายละเอียดงาน"
        android:textColor="#929292"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/debtnBack"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.cardview.widget.CardView
        android:id="@+id/decard1"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/debtnBack">

        <!-- กล่องอันที่หนึ่ง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <!-- ชื่อวิชา -->
            <EditText
                android:id="@+id/deaddProjName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="ชื่อวิชา"
                android:textColor="#454545"
                android:textSize="20sp" />

            <!-- เส้นขีดล่าง -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#BEBEBE" />

            <!-- รายละเอียดงาน -->
            <EditText
                android:id="@+id/deaddProjDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:hint="รายละเอียดงาน"
                android:minHeight="90dp"
                android:textColor="#9A9A9A"
                android:textSize="16sp" />

            <!-- เพิ่มงานย่อย -->
            <TextView
                android:id="@+id/deaddSubtask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+ เพิ่มงานย่อย"
                android:textColor="#6DB1FF"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/derecyclerSubtask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- กรอบสอง -->
    <androidx.cardview.widget.CardView
        android:id="@+id/decard2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/decard1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- วันที่ครบกำหนด -->

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/ic_menu_my_calendar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/detxtDueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:text="วันที่ครบกำหนด"
                android:textColor="#454545"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/detxtDueValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="2026/01/14"
                android:textColor="#6DB1FF"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/detxtDueLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- เวลา -->

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_clock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.328" />

            <TextView
                android:id="@+id/detxtTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="18dp"
                android:text="เวลา"
                android:textColor="#454545"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detxtDueLabel" />

            <TextView
                android:id="@+id/detxtTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="ไม่"
                android:textColor="#6DB1FF"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/detxtTimeLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- เตือนเมื่อ -->

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_notification"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.648" />

            <TextView
                android:id="@+id/detxtNotifyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="18dp"
                android:text="เตือนเมื่อ"
                android:textColor="#454545"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detxtTimeLabel" />

            <TextView
                android:id="@+id/detxtNotifyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="ไม่"
                android:textColor="#6DB1FF"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/detxtNotifyLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_border"
                app:layout_constraintTop_toBottomOf="@id/detxtNotifyLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="18dp"/>

            <TextView
                android:id="@+id/detxtCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="18dp"
                android:text="หมวดหมู่"
                android:textColor="#454545"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detxtNotifyLabel"/>

            <TextView
                android:id="@+id/detxtCategoryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="ไม่มีหมวดหมู่"
                android:textColor="#6DB1FF"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/detxtCategoryLabel"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- กรอบสาม -->
    <androidx.cardview.widget.CardView
        android:id="@+id/decard3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/decard2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- หมายเหตุ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <!-- ซ้าย -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_document"
                    app:layout_constraintTop_toTopOf="@id/detvNoteLabel"
                    app:layout_constraintBottom_toBottomOf="@id/detvNoteLabel"
                    app:layout_constraintVertical_bias="0.454"
                    tools:layout_editor_absoluteX="6dp" />

                <TextView
                    android:id="@+id/detvNoteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="4dp"
                    android:text="หมายเหตุ"
                    android:textColor="#454545"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- ปุ่มเพิ่ม -->
                <TextView
                    android:id="@+id/detvNoteAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="เพิ่ม"
                    android:textColor="#6DB1FF"
                    android:padding="4dp"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBaseline_toBaselineOf="@id/detvNoteLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <!-- ข้อความหมายเหตุ -->
                <TextView
                    android:id="@+id/detvNoteValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:gravity="end"
                    app:layout_constraintBaseline_toBaselineOf="@id/detvNoteLabel"
                    app:layout_constraintStart_toStartOf="@id/detvNoteLabel"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- แนบลิงก์ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/attachmentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <!-- ซ้าย -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_link"
                    app:layout_constraintTop_toTopOf="@id/detvLinkLabel"
                    app:layout_constraintBottom_toBottomOf="@id/detvLinkLabel"
                    app:layout_constraintVertical_bias="0.454"
                    tools:layout_editor_absoluteX="6dp" />

                <TextView
                    android:id="@+id/detvLinkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="4dp"
                    android:text="สิ่งที่แนบมา"
                    android:textColor="#454545"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- ขวา (กดได้) -->
                <!-- ปุ่มเพิ่ม -->
                <TextView
                    android:id="@+id/detvLinkAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ไม่มี"
                    android:textColor="#999999"
                    android:textSize="16sp"
                    android:padding="4dp"
                    android:alpha="0.6"
                    app:layout_constraintBaseline_toBaselineOf="@id/detvLinkLabel"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- ข้อความลิงก์ -->
                <TextView
                    android:id="@+id/detvLinkValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:gravity="end"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:textColorLink="#6DB1FF"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintBaseline_toBaselineOf="@id/detvLinkLabel"
                    app:layout_constraintStart_toEndOf="@id/detvLinkLabel"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- รูปภาพ (เล็ก) -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detvImageThumbnail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:shapeAppearanceOverlay="@style/RoundedCornerImage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/detvLinkLabel"
                    app:layout_constraintBottom_toBottomOf="@id/detvLinkLabel" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="0dp">

        <!-- ปุ่มลบ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/debtnDeleteTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:elevation="8dp"
            android:text="ลบงาน"
            android:textColor="#E53935"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="12dp"
            app:strokeColor="#E53935"
            app:strokeWidth="2dp" />

        <!-- ปุ่มเสร็จ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/debtnCompleteTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:elevation="8dp"
            android:text="งานเสร็จสิ้น"
            android:textColor="#43A047"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="12dp"
            app:strokeColor="#43A047"
            app:strokeWidth="2dp" />

    </LinearLayout>

