<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Project" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="fontFamily">@font/itim</item>
        <item name="android:fontFamily">@font/itim</item>

        <item name="elevationOverlayEnabled">false</item>
        <!-- สี dialog / picker -->
        <item name="colorSurface">#FFFFFF</item>

        <!-- สีปุ่ม -->
        <item name="colorPrimary">#94B9FF</item>
        <item name="colorSecondary">#94B9FF</item>
        <item name="colorPrimaryContainer">#D6E6FF</item>

    </style>

    <style name="Theme.Project" parent="Base.Theme.Project" />

    <style name="RoundedDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/RoundedShape</item>
    </style>

    <style name="RoundedShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
